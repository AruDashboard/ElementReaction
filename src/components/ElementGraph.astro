---
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="原神元素反应关系图" />
    <link rel="icon" type="image/png" href={`${base}images/favicon.png`} />
    <title>原神元素反应关系图</title>
  </head>
  <body>
    <header class="banner">
      <a href="https://arudashboard.github.io/">主页</a> /<div>原神元素反应关系图</div>
      <div class="spacer"></div>
      <button id="btnRelayout" title="重新搜索一个更整洁的布局">
        重新布局
      </button>
      <button id="btnFit" title="将整张图适配到屏幕">
        适应屏幕
      </button>
      <button id="btnPng" data-export title="导出整张图为 PNG">
        下载 PNG
      </button>
      <button id="btnJpg" data-export title="导出整张图为 JPEG">
        下载 JPEG
      </button>
    </header>
    <main>
      <div id="stage">
        <svg id="svg" aria-label="元素反应关系图">
          <defs id="defs"></defs>
          <g id="vp">
            <g id="edges"></g>
            <g id="nodes"></g>
          </g>
        </svg>
      </div>
    </main>
    <footer class="footer">
      <div class="toggles">
        <button
          id="btnMoon"
          class="toggle"
          type="button"
          aria-pressed="false"
          title="显示月反应（月感电、月结晶）"
        >
          月反应
        </button>
        <button
          id="btnStar"
          class="toggle"
          type="button"
          aria-pressed="false"
          title="显示星反应（星超导、星扩散）"
        >
          星反应
        </button>
      </div>
      <div id="status" role="status" aria-live="polite"></div>
    </footer>
    <script>
      import '../scripts/graph.js';
    </script>
  </body>
</html>
